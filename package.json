{
  "name": "clinic-records",
  "version": "0.1.0",
  "description": "诊所单机病历系统",
  "author": "Clinic Records Team",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:desktop": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.ts",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:e2e": "playwright test --project=web",
    "test:e2e:web": "playwright test --project=web",
    "test:e2e:desktop": "npm run build && playwright test --project=desktop",
    "test:e2e:all": "npm run build && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "package:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.clinic.records",
    "productName": "诊所病历",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "clinic-records-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^13.9.0",
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
